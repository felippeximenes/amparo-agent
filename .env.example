# Tudo tem default em src/amparo/config.py — copie para .env só para sobrescrever.

# --- RAG (local) ---
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=amparo_bpc
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM ---
# Padrão: Ollama local (não precisa de variável nenhuma se o Ollama está no ar).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# Para a API da OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-proj-...

# Preços em US$ por 1 milhão de tokens (da sua página de pricing). Se
# preenchidos, o scripts/chat.py mostra o custo estimado da sessão.
# LLM_PRECO_ENTRADA=0.15
# LLM_PRECO_SAIDA=0.60
